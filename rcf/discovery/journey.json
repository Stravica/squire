      "id": "JNY-001",
      "slug": "first-run",
      "actor": "A Squire owner on their own Mac",
      "goal": "From opening the download to the first reply from their own Squire, without Terminal",
      "source": "rcf/discovery/first-run.journey",
      "steps": [
        {
          "id": "JNY-001-001",
          "slug": "open-download",
          "kind": "entry",
          "screenId": "SCR-001",
          "label": "Open the downloaded Squire app; macOS stops it once and the owner clicks Open Anyway in System Settings, Privacy and Security",
          "next": [
            "JNY-001-002"
          ],
          "returnsTo": null
        },
        {
          "id": "JNY-001-002",
          "slug": "mac-check",
          "kind": "step",
          "screenId": "SCR-002",
          "label": "The Mac check: macOS 13 or later, 4 GB of memory, and Apple's command line tools present or installable by this user; a Mac that fails is refused here, before any change",
          "next": [
            "JNY-001-003"
          ],
          "returnsTo": null
        },
        {
          "id": "JNY-001-003",
          "slug": "declare-plan",
          "kind": "step",
          "screenId": "SCR-002",
          "label": "The owner says which Claude plan they have; a plan below Pro is refused here, before any change",
          "next": [
            "JNY-001-004"
          ],
          "returnsTo": null
        },
        {
          "id": "JNY-001-004",
          "slug": "one-yes",
          "kind": "step",
          "screenId": "SCR-002",
          "label": "One yes for everything set-up installs: Claude Code with its own background updates, Apple's command line tools with the system's administrator password prompt, Squire and its background jobs; a no installs nothing",
          "next": [
            "JNY-001-005"
          ],
          "returnsTo": null
        },
        {
