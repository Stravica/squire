{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B \"${SQUIRE_HOME:-$HOME/Library/Application Support/Squire}/core/hooks/pre-tool-use.py\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B \"${SQUIRE_HOME:-$HOME/Library/Application Support/Squire}/core/hooks/user-prompt-submit.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B \"${SQUIRE_HOME:-$HOME/Library/Application Support/Squire}/core/hooks/session-start.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B \"${SQUIRE_HOME:-$HOME/Library/Application Support/Squire}/core/hooks/config-change.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "crossSessionInbound": "accept"
}
